# Public Firebase web-app configuration (Firebase Console > Project settings > Your apps)
EXPO_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
EXPO_PUBLIC_FIREBASE_APP_ID=your_firebase_app_id
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=your_optional_measurement_id

# UID of the one Google account allowed to access this personal app
EXPO_PUBLIC_FIREBASE_OWNER_UID=your_firebase_owner_uid

# Server-only. Add this to Vercel; never prefix it with EXPO_PUBLIC_.
TMDB_READ_ACCESS_TOKEN=your_tmdb_api_read_access_token
